---
// 계산 결과 표시. 빌드 시 기본값으로 계산한 결과를 먼저 그려 두고, 브라우저에서 같은 마크업으로 교체한다.
import type { CalcResult } from '../../calculators/types';
import { renderResultHtml } from '../../lib/result-html';

interface Props {
  result: CalcResult;
  /** 페이지의 실시간 결과 영역이면 true (id="calc-result", aria-live) */
  live?: boolean;
}
const { result, live = false } = Astro.props;
---

{
  live ? (
    <div id="calc-result" class="result" aria-live="polite" set:html={renderResultHtml(result)} />
  ) : (
    <div class="result" set:html={renderResultHtml(result)} />
  )
}
